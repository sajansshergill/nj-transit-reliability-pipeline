# --- Data lake (S3 or MinIO) ---
S3_BUCKET=njt-reliability-dev
# For local MinIO, set the endpoint; leave unset for real AWS S3.
# S3_ENDPOINT_URL=http://localhost:9000
AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY via your normal AWS credential chain.

# --- NJ Transit sources (requires a free NJT developer account) ---
NJT_GTFS_STATIC_URL=
NJT_GTFS_RT_TRIP_UPDATES_URL=
NJT_API_KEY=

# --- Weather (Open-Meteo, no key needed) ---
WEATHER_BASE_URL=https://api.open-meteo.com/v1/forecast

# --- Business rule ---
ON_TIME_THRESHOLD_SECONDS=300

# --- Warehouse (Snowflake, prod target only) ---
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
SNOWFLAKE_PASSWORD=
SNOWFLAKE_ROLE=
SNOWFLAKE_DATABASE=NJT_RELIABILITY
SNOWFLAKE_SCHEMA=RAW
SNOWFLAKE_WAREHOUSE=COMPUTE_WH
SNOWFLAKE_STAGE=NJT_SILVER_STAGE

# --- dbt / Spark runtime hints ---
DBT_TARGET=duckdb
SPARK_MASTER=local[*]